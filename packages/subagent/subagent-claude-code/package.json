{
  "name": "@huiliyi37/dsh-subagent-claude-code",
  "description": "One-shot Claude Code subagent provider over the official Agent SDK",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-tui.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-subagent": "^0.2.0",
    "@huiliyi37/dsh-subprocess": "^0.2.0",
    "@huiliyi37/dsh-timeout": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-loader-smoke": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-subagent": "workspace:^",
    "@huiliyi37/dsh-subprocess": "workspace:^",
    "@huiliyi37/dsh-subprocess-local": "workspace:^",
    "@huiliyi37/dsh-timeout": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  }
}
