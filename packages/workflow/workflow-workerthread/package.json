{
  "name": "@huiliyi37/dsh-workflow-workerthread",
  "description": "worker-thread workflow engine: executes model-written orchestration scripts off the host event loop, bridging agent() calls back to ctx.subagents",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-tui.git",
    "directory": "packages/workflow/workflow-workerthread"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@huiliyi37/dsh-agent": "^0.2.0",
    "@huiliyi37/dsh-brand": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-llm": "^0.2.0",
    "@huiliyi37/dsh-session": "^0.2.0",
    "@huiliyi37/dsh-subagent": "^0.2.0",
    "@huiliyi37/dsh-tools": "^0.2.0",
    "@huiliyi37/dsh-workflow": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@huiliyi37/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-agent-loop": "workspace:^",
    "@huiliyi37/dsh-agent-loop-testkit": "workspace:^",
    "@huiliyi37/dsh-brand": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-subagent": "workspace:^",
    "@huiliyi37/dsh-subagent-spawn": "workspace:^",
    "@huiliyi37/dsh-system-prompt": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "@huiliyi37/dsh-workflow": "workspace:^",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "tsx": "^4.23.1"
  }
}
