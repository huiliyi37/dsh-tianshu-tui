{
  "name": "@huiliyi37/dsh-client-ui-model",
  "description": "Model selection: the /model popupSelect over session.models / session.selectModel",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-tui.git",
    "directory": "packages/client/ui-model"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dshClient": {
    "inject": [
      "@huiliyi37/dsh-client-locale",
      "@huiliyi37/dsh-client-runtime",
      "@huiliyi37/dsh-client-ui-command"
    ],
    "platform": "web"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@huiliyi37/dsh-client-connection": "^0.2.0",
    "@huiliyi37/dsh-client-locale": "^0.2.0",
    "@huiliyi37/dsh-client-runtime": "^0.2.0",
    "@huiliyi37/dsh-client-ui-command": "^0.2.0",
    "@huiliyi37/dsh-client-ui-conversation": "^0.2.0",
    "@huiliyi37/dsh-client-ui-primitives": "^0.2.0",
    "@huiliyi37/dsh-client-ui-slash": "^0.2.0",
    "@huiliyi37/dsh-client-ui-slots": "^0.2.0",
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "clsx": "^2.1.1",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@huiliyi37/dsh-client-connection": "workspace:^",
    "@huiliyi37/dsh-client-locale": "workspace:^",
    "@huiliyi37/dsh-client-runtime": "workspace:^",
    "@huiliyi37/dsh-client-ui-command": "workspace:^",
    "@huiliyi37/dsh-client-ui-conversation": "workspace:^",
    "@huiliyi37/dsh-client-ui-primitives": "workspace:^",
    "@huiliyi37/dsh-client-ui-slash": "workspace:^",
    "@huiliyi37/dsh-client-ui-slots": "workspace:^",
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@types/react": "~19.2.17",
    "clsx": "^2.1.1",
    "@huiliyi37/cordis": "^4.0.0-rc.7",
    "react": "^19.2.7"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
