{
  "name": "@huiliyi37/dsh-client-runtime",
  "description": "Client core services: SlotsService, SessionsService (scope tree + object layer)",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiliyi37/dsh-tianshu-tui.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dshClient": {
    "inject": [
      "@huiliyi37/dsh-client-connection",
      "@huiliyi37/dsh-typert-registry"
    ],
    "platform": "web",
    "immediately": true
  },
  "license": "MIT",
  "dependencies": {
    "@huiliyi37/dsh-agent": "workspace:^",
    "@huiliyi37/dsh-client-connection": "workspace:^",
    "@huiliyi37/dsh-commands": "workspace:^",
    "@huiliyi37/dsh-compact": "workspace:^",
    "@huiliyi37/dsh-client-ui-slots": "workspace:^",
    "@huiliyi37/dsh-host-apiproxy": "workspace:^",
    "@huiliyi37/dsh-llm": "workspace:^",
    "@huiliyi37/dsh-llm-retry": "workspace:^",
    "@huiliyi37/dsh-session": "workspace:^",
    "@huiliyi37/dsh-session-projection": "workspace:^",
    "@huiliyi37/dsh-session-title": "workspace:^",
    "@huiliyi37/dsh-tools": "workspace:^",
    "immer": "^10.1.1",
    "react": "^19.2.7",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@huiliyi37/dsh-invariants": "^0.2.0",
    "@huiliyi37/dsh-type-meta": "^0.2.0",
    "@huiliyi37/dsh-typert-registry": "^0.2.0",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@huiliyi37/dsh-invariants": "workspace:^",
    "@huiliyi37/dsh-timeout": "workspace:^",
    "@huiliyi37/dsh-type-meta": "workspace:^",
    "@huiliyi37/dsh-typert-registry": "workspace:^",
    "@types/react": "~19.2.17",
    "@huiliyi37/cordis": "^4.0.0-rc.7"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
